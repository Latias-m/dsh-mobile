{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "DSH 移动端"
      }
    },
    {
      "path": "pages/connect/connect",
      "style": {
        "navigationBarTitleText": "连接 DSH"
      }
    },
    {
      "path": "pages/chat/chat",
      "style": {
        "navigationBarTitleText": "会话"
      }
    },
    {
      "path": "pages/session-create/session-create",
      "style": {
        "navigationBarTitleText": "新建会话"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "DSH 移动端",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
